{
  "name": "@goodali/pi-dispatch",
  "version": "0.1.2",
  "description": "Programmable subagent dispatch for pi: queue, spawn, watch, stop, and account for child agents",
  "keywords": [
    "agent",
    "agents",
    "autonomous",
    "delegation",
    "dispatch",
    "multi-agent",
    "orchestration",
    "parallel",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "subagent",
    "subagents",
    "task-queue",
    "verification"
  ],
  "homepage": "https://github.com/a1121611810/pi-dispatch",
  "bugs": "https://github.com/a1121611810/pi-dispatch/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1121611810/pi-dispatch.git"
  },
  "files": [
    "dist/**/*.js",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "rolldown -c",
    "prepack": "npm run build",
    "prepublishOnly": "pnpm fmt:check && pnpm lint && pnpm check && pnpm test && pnpm check:privacy",
    "build:check": "pnpm build && git diff --exit-code -- dist",
    "check": "tsrs -p tsconfig.json",
    "lint": "oxlint --ignore-path .oxfmtignore",
    "fmt": "oxfmt --ignore-path .oxfmtignore",
    "fmt:check": "oxfmt --check --ignore-path .oxfmtignore",
    "test": "node scripts/test.ts",
    "check:privacy": "node scripts/privacy-gate.ts",
    "sanitize:fixture": "node scripts/sanitize-fixture.ts",
    "test:coverage": "node scripts/test.ts --experimental-test-coverage",
    "test:node22": "npx -y node@22.19.0 scripts/test.ts",
    "mutate": "mutator --no-coverage src",
    "test:node24": "npx -y node@24 scripts/test.ts",
    "test:mode": "node scripts/verify-modes.ts",
    "check:breakpoints": "node scripts/breakpoints.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "rolldown": "^1.3.2",
    "tsrs": "0.25.0-ts7.1.0-beta"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@12.15.0",
  "pi": {
    "image": "https://raw.githubusercontent.com/a1121611810/pi-dispatch/main/assets/social-preview.png",
    "extensions": [
      "./dist/index.js"
    ]
  }
}
